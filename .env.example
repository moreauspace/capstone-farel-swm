# SQLite lokal (file dibuat di folder prisma/)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# SMTP untuk OTP lupa kata sandi.
# Kosongkan SMTP_HOST saat development: kode OTP tampil di layar (tidak dikirim).
# Isi lengkap saat production — kode tidak akan pernah dikembalikan ke browser.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PT Satya Wira Mandiri <noreply@satyawira.co.id>"

